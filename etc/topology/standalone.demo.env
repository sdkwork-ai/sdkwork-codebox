# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated demo PostgreSQL schema/database `sdkwork_codebox_demo` (DB identity).
# Redis isolation: any cache/rate-limit keys use a dedicated logical DB index so no key collides
# with another shared-redis environment. This profile declares no concrete redis/database env keys;
# provisioning must assign them before activation.
SDKWORK_CODEBOX_DEPLOYMENT_PROFILE=standalone
SDKWORK_CODEBOX_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CODEBOX_PROFILE_ID=standalone.demo
SDKWORK_CODEBOX_APPLICATION_PUBLIC_HTTP_URL=https://codebox-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CODEBOX_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://codebox-demo.sdkwork.com,http://codebox-demo.sdkwork.com,https://codebox-demo.birdcoder.com,http://codebox-demo.birdcoder.com,https://codebox-demo.dtupay.com,http://codebox-demo.dtupay.com,https://codebox-demo.noaper.com,http://codebox-demo.noaper.com,https://codebox-demo.sdkwork.cn,http://codebox-demo.sdkwork.cn,https://codebox-demo.birdcoder.cn,http://codebox-demo.birdcoder.cn,https://codebox-demo.dtupay.cn,http://codebox-demo.dtupay.cn,https://codebox-demo.noaper.cn,http://codebox-demo.noaper.cn,https://codebox-demo.skubc.com,http://codebox-demo.skubc.com,https://codebox-demo.skubc.cn,http://codebox-demo.skubc.cn,https://codebox-demo.zowalk.com,http://codebox-demo.zowalk.com,https://codebox-demo.zowalk.cn,http://codebox-demo.zowalk.cn,https://codebox-demo.offer86.com,http://codebox-demo.offer86.com,https://codebox-demo.offer86.cn,http://codebox-demo.offer86.cn,https://codebox-demo.86offer.com,http://codebox-demo.86offer.com,https://codebox-demo.86offer.cn,http://codebox-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
